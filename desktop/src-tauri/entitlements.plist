<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required so the sidecar (PyInstaller-frozen Python) and FFmpeg can
       load their dynamic libraries (Python framework, ffmpeg dylibs) under
       the hardened runtime. Without this, PyInstaller-frozen binaries
       fail to launch under notarized builds. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- App is not sandboxed for v1 (Tauri direct-download distribution).
       File access works via Tauri's dialog plugin and full-disk Finder
       paths, not security-scoped bookmarks.
       Sidecar spawn does not require any extra entitlement under the
       hardened runtime — it works by default once library-validation
       is relaxed above. -->
</dict>
</plist>
