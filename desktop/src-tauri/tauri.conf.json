{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marquee",
  "version": "0.1.0",
  "identifier": "com.thedetech.marquee",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marquee",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Photography",
    "shortDescription": "Ken Burns slideshows from your photo archives.",
    "longDescription": "Marquee turns folders of photos and videos into MP4 slideshows with Ken Burns motion, automatic EXIF date and location overlays, and optional background music. Works fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/slideshow-gen"],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "signingIdentity": "Developer ID Application: ADAM SPENCER THEDE (U85N54PC5J)",
      "entitlements": "entitlements.plist"
    }
  }
}
